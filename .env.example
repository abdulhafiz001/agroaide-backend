APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Lagos

# Host allowlisting is off by default so Coolify/mobile login works.
# Set ENFORCE_TRUSTED_HOSTS=true and list public hostnames if you want it locked down.
ENFORCE_TRUSTED_HOSTS=false
TRUSTED_HOSTS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Calendar-day caps per farmer (scans / advisor user messages).
DAILY_SCAN_LIMIT=4
DAILY_CHAT_LIMIT=8

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agroaide
DB_USERNAME=agroaide
DB_PASSWORD=

# For local-only SQLite instead of MySQL, use:
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CORS_ALLOWED_ORIGINS=*

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# External API Keys — never commit real values
# Optional PlantNet plant identification (https://my.plantnet.org/)
PLANTNET_API_KEY=

# Crop scans — Kindwise crop.health (https://crop.kindwise.com). Backend only.
KINDWISE_API_KEY=
KINDWISE_API_URL=https://crop.kindwise.com/api/v1

# Primary AI — Google AI Studio / Gemini (https://aistudio.google.com/apikey). Backend only.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash

# Optional legacy NVIDIA fallback (https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_TEXT_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# Voice transcription (+ optional AI backup) (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_TEXT_MODEL=qwen/qwen3.6-27b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Firebase Cloud Messaging (direct FCM HTTP v1)
FCM_PROJECT_ID=
# Path to service account JSON — keep file gitignored (see .gitignore)
# Coolify/Docker may mount e.g. /run/secrets/firebase.json
FCM_CREDENTIALS_PATH=firebase-service-account.json

# Market Eye crowd-verified prices (https://marketeye.ahzcode.sbs/developers)
MARKETEYE_API_KEY=
MARKETEYE_BASE_URL=https://marketeye.ahzcode.sbs/api/v1/public
